{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTC Signals Destination Retry State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "delivery_id", "attempt_count", "phase", "current_attempt_id",
    "started_at", "finished_at", "retry_not_before", "outcome"
  ],
  "properties": {
    "schema_version": { "const": "btc.signals.retry-state/v1" },
    "delivery_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "phase": { "enum": ["ready", "in_flight", "backoff"] },
    "current_attempt_id": {
      "type": ["string", "null"], "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "started_at": { "type": ["string", "null"], "format": "date-time" },
    "finished_at": { "type": ["string", "null"], "format": "date-time" },
    "retry_not_before": { "type": ["string", "null"], "format": "date-time" },
    "outcome": {
      "type": ["string", "null"],
      "enum": ["submitted_without_acknowledgement", "retryable_failure", null]
    }
  }
}
