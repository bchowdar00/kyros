{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "version",
    "name",
    "description",
    "status",
    "transport",
    "fields",
    "event_time_field"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "experimental", "approved", "deprecated"]
    },
    "transport": {
      "enum": ["websocket", "http_poll", "file_replay", "sse"]
    },
    "expected_heartbeat_ms": { "type": "integer", "minimum": 1 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "event_time_field": { "$ref": "#/$defs/fieldName" },
    "sequence_field": { "$ref": "#/$defs/fieldName" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "location"],
      "properties": {
        "name": { "$ref": "#/$defs/fieldName" },
        "type": {
          "enum": [
            "bool",
            "string",
            "decimal",
            "u8",
            "u16",
            "u32",
            "u64",
            "i64",
            "timestamp",
            "duration_ms",
            "enum"
          ]
        },
        "location": { "enum": ["external", "internal"] },
        "variants": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": {
            "required": ["variants"],
            "properties": { "variants": { "minItems": 1 } }
          },
          "else": { "properties": { "variants": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
