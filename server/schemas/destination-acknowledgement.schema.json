{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTC Signals Destination Acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "destination", "delivery_id", "recorded_at", "consumer_receipt"
  ],
  "properties": {
    "schema_version": { "const": "btc.signals.destination-acknowledgement/v1" },
    "destination": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "delivery_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "consumer_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "package_id", "publisher_epoch", "last_sequence",
        "verified_manifest_sha256"
      ],
      "properties": {
        "schema_version": { "const": "btc.signals.consumer-receipt/v1" },
        "package_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "publisher_epoch": { "type": "string", "minLength": 1 },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "verified_manifest_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
