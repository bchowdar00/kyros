{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTC Signals Durable Spool Entry",
  "$defs": {
    "spoolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "required_destinations", "maximum_spool_bytes",
        "maximum_active_items", "minimum_free_bytes", "minimum_free_inodes", "retention"
      ],
      "properties": {
        "schema_version": { "const": "btc.signals.spool-policy/v1" },
        "required_destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "maximum_spool_bytes": { "type": "integer", "minimum": 1 },
        "maximum_active_items": { "type": "integer", "minimum": 1 },
        "minimum_free_bytes": { "type": "integer", "minimum": 1 },
        "minimum_free_inodes": { "type": "integer", "minimum": 1 },
        "retention": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "keep_forever" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "minimum_seconds"],
              "properties": {
                "mode": { "const": "after_all_acknowledged" },
                "minimum_seconds": { "type": "integer", "minimum": 0 }
              }
            }
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "enqueued_at", "package_id", "manifest_sha256", "publisher_epoch",
    "last_sequence", "package_bytes", "policy", "policy_sha256"
  ],
  "properties": {
    "schema_version": { "const": "btc.signals.spool-entry/v1" },
    "enqueued_at": { "type": "string", "format": "date-time" },
    "package_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publisher_epoch": { "type": "string", "minLength": 1, "maxLength": 128 },
    "last_sequence": { "type": "integer", "minimum": 0 },
    "package_bytes": { "type": "integer", "minimum": 1 },
    "policy": { "$ref": "#/$defs/spoolPolicy" },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "supersedes_package_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
