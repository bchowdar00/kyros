{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal Stream Message",
  "description": "Known framed signal-stream messages. Consumers dispatch on type and ignore unknown message types before validating one of these closed shapes.",
  "oneOf": [
    { "$ref": "#/$defs/signal_batch" },
    { "$ref": "#/$defs/instance_status" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/status" },
    { "$ref": "#/$defs/reset" },
    { "$ref": "#/$defs/market_transition" },
    { "$ref": "#/$defs/feed_health" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "market_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:-]*[A-Za-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "publisher_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "global" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "market_id", "market_generation"],
          "properties": {
            "type": { "const": "market" },
            "market_id": { "$ref": "#/$defs/market_id" },
            "market_generation": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "legs", "window"],
          "properties": {
            "type": { "const": "multi_market" },
            "legs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "description": "Ascending by (venue, market_id) byte order; an unsorted array is rejected, never re-sorted. The whole array plus the window is the instance key. At most two legs, because legs are on distinct market-scope venues and there are two.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["venue", "market_id", "market_generation"],
                "properties": {
                  "venue": { "enum": ["polymarket", "kalshi"] },
                  "market_id": { "$ref": "#/$defs/market_id" },
                  "market_generation": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "window": {
              "type": "object",
              "additionalProperties": false,
              "description": "RFC 3339 bounds with open strictly before close, compared as instants. The whole serialized scope object is bounded at 1024 bytes.",
              "required": ["open", "close"],
              "properties": {
                "open": { "type": "string", "format": "date-time" },
                "close": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons"],
      "properties": {
        "state": { "const": "ready" },
        "reasons": { "type": "array", "const": [] }
      }
    },
    "signal_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "signal_id",
        "signal_version",
        "publisher_epoch",
        "sequence",
        "event_time",
        "produced_at",
        "valid_from",
        "valid_until",
        "quality",
        "values",
        "scope"
      ],
      "properties": {
        "schema_version": { "const": 3 },
        "signal_id": { "$ref": "#/$defs/id" },
        "signal_version": { "$ref": "#/$defs/version" },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": {
          "$ref": "#/$defs/sequence",
          "description": "Per-signal sequence scoped to publisher_epoch, signal_id, and signal_version."
        },
        "event_time": { "$ref": "#/$defs/timestamp" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "quality": { "$ref": "#/$defs/quality" },
        "values": { "type": "object" },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "reason": {
      "enum": [
        "book_flow_history_warming_up",
        "book_history_warming_up",
        "coinbase_book_invalid",
        "kraken_book_invalid",
        "trade_history_warming_up",
        "trade_venue_stale_or_missing",
        "reference_unavailable",
        "reference_constituents_unavailable",
        "reference_history_warming_up",
        "trade_window_empty",
        "book_snapshot_stale_or_missing",
        "upstream_measurement_unavailable",
        "coinbase_venue_unavailable",
        "kraken_venue_unavailable",
        "coinbase_stale",
        "coinbase_warming_up",
        "coinbase_invalid_quote",
        "coinbase_midpoint_unrepresentable",
        "coinbase_disconnected",
        "coinbase_recovery_required",
        "coinbase_subscription_rejected",
        "kraken_stale",
        "kraken_warming_up",
        "kraken_invalid_quote",
        "kraken_midpoint_unrepresentable",
        "kraken_disconnected",
        "kraken_recovery_required",
        "kraken_subscription_rejected",
        "cross_venue_dispersion_exceeded",
        "reference_arithmetic_unrepresentable",
        "market_closed",
        "opening_strike_unavailable",
        "probe_depth_insufficient",
        "trade_stale_or_missing",
        "model_domain_exceeded",
        "model_denominator_zero",
        "volatility_warming_up",
        "volatility_zero",
        "market_contract_warming_up",
        "market_clock_unrepresentable",
        "last_trade_missing",
        "last_trade_stale",
        "book_stale",
        "book_snapshot_missing",
        "book_one_sided",
        "book_crossed_or_invalid",
        "negative_book_stale",
        "negative_book_snapshot_missing",
        "negative_book_one_sided",
        "negative_book_crossed_or_invalid",
        "kalshi_complement_invalid",
        "affirmative_quote_missing",
        "affirmative_quote_crossed_or_invalid",
        "affirmative_quote_stale",
        "negative_quote_missing",
        "negative_quote_crossed_or_invalid",
        "negative_quote_stale",
        "market_rollover",
        "market_discovery_unreachable",
        "next_market_unlisted",
        "market_discovery_invalid",
        "market_open_gap",
        "provider_lifecycle_change",
        "basis_history_warming_up",
        "binance_band_exceeds_captured_depth",
        "binance_book_invalid",
        "binance_disconnected",
        "binance_invalid_quote",
        "binance_midpoint_unrepresentable",
        "binance_recovery_required",
        "binance_stale",
        "binance_subscription_rejected",
        "binance_venue_unavailable",
        "binance_warming_up",
        "bybit_book_invalid",
        "bybit_disconnected",
        "bybit_invalid_quote",
        "bybit_midpoint_unrepresentable",
        "bybit_recovery_required",
        "bybit_stale",
        "bybit_subscription_rejected",
        "bybit_venue_unavailable",
        "bybit_warming_up",
        "cfbrti_anchor_missing",
        "cfbrti_anchor_window_thin",
        "cfbrti_disconnected",
        "cfbrti_entitlement_denied",
        "cfbrti_stale",
        "cfbrti_subscription_rejected",
        "cfbrti_unavailable",
        "cfbrti_value_invalid",
        "cfbrti_warming_up",
        "chainlink_reorg_detected",
        "chainlink_round_invalid",
        "chainlink_rpc_unavailable",
        "chainlink_stale",
        "chainlink_warming_up",
        "counterparty_venue_unavailable",
        "derivatives_constituents_unavailable",
        "funding_info_missing",
        "funding_interval_mismatch",
        "funding_unavailable",
        "leg_market_closed",
        "leg_market_unbound",
        "liquidation_burst_not_observed",
        "liquidation_side_unconfirmed",
        "open_interest_history_warming_up",
        "open_interest_unavailable",
        "oracle_constituents_unavailable",
        "oracle_rights_gated",
        "perp_venue_stale",
        "pyth_disconnected",
        "pyth_gap",
        "pyth_stale",
        "pyth_warming_up",
        "window_alignment_mismatch",
        "usdt_reference_stale",
        "no_qualifying_move",
        "flat_window",
        "chainlink_rounds_sparse"
      ]
    },
    "instance_status_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "signal_version",
        "scope",
        "state",
        "reasons",
        "effective_time",
        "last_decision_sequence"
      ],
      "properties": {
        "signal_id": { "$ref": "#/$defs/id" },
        "signal_version": { "$ref": "#/$defs/version" },
        "scope": { "$ref": "#/$defs/scope" },
        "state": { "enum": ["warming_up", "degraded", "unavailable", "invalidated"] },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason" }
        },
        "effective_time": { "$ref": "#/$defs/timestamp" },
        "last_decision_sequence": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "instance_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "signal_id",
        "signal_version",
        "scope",
        "state",
        "reasons",
        "effective_time",
        "last_decision_sequence"
      ],
      "properties": {
        "type": { "const": "instance_status" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "signal_id": { "$ref": "#/$defs/id" },
        "signal_version": { "$ref": "#/$defs/version" },
        "scope": { "$ref": "#/$defs/scope" },
        "state": { "enum": ["warming_up", "degraded", "unavailable", "invalidated"] },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reason" }
        },
        "effective_time": { "$ref": "#/$defs/timestamp" },
        "last_decision_sequence": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "producer_status": {
      "enum": ["starting", "ready", "degraded"]
    },
    "signal_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "conflation_policy",
        "values_semantics",
        "updates"
      ],
      "properties": {
        "type": { "const": "signal_batch" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "conflation_policy": {
          "const": "none",
          "description": "Every admitted data batch is published on this channel; sequence gaps are not authorized conflation."
        },
        "values_semantics": {
          "const": "full_replace",
          "description": "Each update replaces the prior values map for its exact signal identity and version; omitted fields are cleared."
        },
        "updates": {
          "type": "array",
          "minItems": 1,
          "description": "One atomic evaluation unit. Apply the complete validated array in order or apply none of it.",
          "items": { "$ref": "#/$defs/signal_update" }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "as_of_sequence",
        "conflation_policy",
        "values_semantics",
        "updates",
        "statuses"
      ],
      "properties": {
        "type": { "const": "snapshot" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "as_of_sequence": {
          "$ref": "#/$defs/sequence",
          "description": "Publisher-wide sequence of the last decision-or-status frame incorporated into this snapshot."
        },
        "conflation_policy": {
          "const": "none",
          "description": "Matches the non-conflated data channel represented by this snapshot."
        },
        "values_semantics": {
          "const": "full_replace",
          "description": "Each snapshot update replaces the prior values map for its exact signal identity and version."
        },
        "updates": {
          "type": "array",
          "description": "Unexpired non-invalidated ready decisions, sorted ascending by full instance key. May be empty.",
          "items": { "$ref": "#/$defs/signal_update" }
        },
        "statuses": {
          "type": "array",
          "description": "Current non-ready status entries and bounded invalidation tombstones, sorted ascending by full instance key. May be empty.",
          "items": { "$ref": "#/$defs/instance_status_entry" }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "heartbeat_interval_ms",
        "status",
        "as_of_sequence"
      ],
      "properties": {
        "type": { "const": "heartbeat" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "heartbeat_interval_ms": {
          "const": 5000,
          "description": "Declared producer liveness interval in milliseconds."
        },
        "status": { "$ref": "#/$defs/producer_status" },
        "as_of_sequence": {
          "oneOf": [
            { "$ref": "#/$defs/sequence" },
            { "type": "null" }
          ]
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "status",
        "reasons",
        "as_of_sequence"
      ],
      "properties": {
        "type": { "const": "status" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "status": { "$ref": "#/$defs/producer_status" },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "as_of_sequence": {
          "oneOf": [
            { "$ref": "#/$defs/sequence" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ready" } } },
          "then": { "properties": { "reasons": { "maxItems": 0 } } },
          "else": { "properties": { "reasons": { "minItems": 1 } } }
        }
      ]
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "reason"
      ],
      "properties": {
        "type": { "const": "reset" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "reason": { "const": "publisher_epoch_started" }
      }
    },
    "market_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "venue",
        "market_generation",
        "previous_market_id",
        "next_market_id",
        "phase",
        "reason"
      ],
      "properties": {
        "type": { "const": "market_transition" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "venue": { "enum": ["polymarket", "kalshi"] },
        "market_generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Generation reserved for the pending or newly bound market. Retries retain it; a later bind uses the same value."
        },
        "previous_market_id": {
          "oneOf": [
            { "$ref": "#/$defs/market_id" },
            { "type": "null" }
          ]
        },
        "next_market_id": {
          "oneOf": [
            { "$ref": "#/$defs/market_id" },
            { "type": "null" }
          ]
        },
        "phase": { "enum": ["unavailable", "bound"] },
        "reason": {
          "enum": [
            "initial_bind",
            "scheduled_rollover",
            "discovery_unreachable",
            "next_market_unlisted",
            "invalid_discovery",
            "close_to_next_open_gap",
            "provider_lifecycle_change",
            "recovery_bind"
          ]
        }
      }
    },
    "feed_health_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "venue",
        "status",
        "last_event_age_ms",
        "down_since",
        "disconnect_count",
        "reconnect_count",
        "anomaly_velocity"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "venue": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "enum": ["live", "degraded", "reconnecting", "down"] },
        "last_event_age_ms": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ],
          "description": "Milliseconds since the feed's most recent admitted event; null before any event."
        },
        "down_since": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ],
          "description": "When the current outage began; null when the feed is not in a down/reconnecting outage."
        },
        "disconnect_count": { "type": "integer", "minimum": 0 },
        "reconnect_count": { "type": "integer", "minimum": 0 },
        "anomaly_velocity": {
          "type": "integer",
          "minimum": 0,
          "description": "Abnormal availability events observed within the rolling anomaly window."
        }
      }
    },
    "feed_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "publisher_epoch",
        "sequence",
        "produced_at",
        "feeds"
      ],
      "properties": {
        "type": { "const": "feed_health" },
        "schema_version": { "const": 3 },
        "publisher_epoch": { "$ref": "#/$defs/publisher_epoch" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "produced_at": { "$ref": "#/$defs/timestamp" },
        "feeds": {
          "type": "array",
          "minItems": 1,
          "description": "Observe-only per-feed liveness health. The producer reports and escalates; it never acts on this.",
          "items": { "$ref": "#/$defs/feed_health_report" }
        }
      }
    }
  }
}
