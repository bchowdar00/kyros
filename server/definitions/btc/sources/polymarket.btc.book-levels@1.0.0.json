{
  "schema_version": 1,
  "source_id": "polymarket.btc.book-levels",
  "version": "1.0.0",
  "name": "Polymarket BTC order-book levels",
  "description": "Flattened Polymarket market-channel book snapshots and absolute price_change rows for verified BTC outcome tokens. Rows sharing update_group form one atomic source message and must be applied in update_index order; size zero removes a level. BUY maps to bid and SELL maps to ask, outcome is resolved from the archived Gamma contract, and event_time is the provider Unix-millisecond timestamp rendered as RFC 3339.",
  "status": "approved",
  "transport": "websocket",
  "fields": [
    { "name": "condition_id", "type": "string", "location": "external" },
    { "name": "asset_id", "type": "string", "location": "external" },
    {
      "name": "outcome",
      "type": "enum",
      "location": "internal",
      "variants": ["up", "down"]
    },
    { "name": "update_group", "type": "string", "location": "internal" },
    { "name": "update_index", "type": "u32", "location": "internal" },
    { "name": "update_count", "type": "u32", "location": "internal" },
    {
      "name": "update_kind",
      "type": "enum",
      "location": "internal",
      "variants": ["snapshot", "delta"]
    },
    {
      "name": "side",
      "type": "enum",
      "location": "internal",
      "variants": ["bid", "ask"]
    },
    { "name": "price", "type": "decimal", "location": "external" },
    { "name": "size", "type": "decimal", "location": "external" },
    { "name": "event_time", "type": "timestamp", "location": "external" }
  ],
  "event_time_field": "event_time"
}
