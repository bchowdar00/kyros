{
  "schema_version": 1,
  "source_id": "coinbase.exchange.btc-usd.trades",
  "version": "1.0.0",
  "name": "Coinbase Exchange BTC-USD trades",
  "description": "Normalized Coinbase Exchange BTC-USD matches. maker_side preserves the provider field and aggressor_side is its inverse. trade_id provides contiguous ordering and lets heartbeat-detected gaps be restored with the public REST trade history before publication resumes.",
  "status": "approved",
  "transport": "websocket",
  "expected_heartbeat_ms": 1000,
  "fields": [
    { "name": "instrument", "type": "string", "location": "external" },
    { "name": "trade_id", "type": "u64", "location": "external" },
    { "name": "price", "type": "decimal", "location": "external" },
    { "name": "size", "type": "decimal", "location": "external" },
    {
      "name": "maker_side",
      "type": "enum",
      "location": "external",
      "variants": ["buy", "sell"]
    },
    {
      "name": "aggressor_side",
      "type": "enum",
      "location": "internal",
      "variants": ["buy", "sell"]
    },
    { "name": "event_time", "type": "timestamp", "location": "external" }
  ],
  "event_time_field": "event_time",
  "sequence_field": "trade_id"
}
