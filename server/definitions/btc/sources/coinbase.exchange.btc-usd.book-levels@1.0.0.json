{
  "schema_version": 1,
  "source_id": "coinbase.exchange.btc-usd.book-levels",
  "version": "1.0.0",
  "name": "Coinbase Exchange BTC-USD level-two book levels",
  "description": "Flattened absolute price levels from the Coinbase Exchange BTC-USD initial snapshot and level2_batch updates. Rows sharing update_group form one atomic source message and must be applied in update_index order; size zero removes a level. Timestamp-less snapshots use receipt time and declare that basis explicitly.",
  "status": "approved",
  "transport": "websocket",
  "expected_heartbeat_ms": 1000,
  "fields": [
    { "name": "instrument", "type": "string", "location": "external" },
    { "name": "update_group", "type": "string", "location": "internal" },
    { "name": "update_index", "type": "u32", "location": "internal" },
    { "name": "update_count", "type": "u32", "location": "internal" },
    {
      "name": "update_kind",
      "type": "enum",
      "location": "internal",
      "variants": ["snapshot", "delta"]
    },
    {
      "name": "side",
      "type": "enum",
      "location": "internal",
      "variants": ["bid", "ask"]
    },
    { "name": "price", "type": "decimal", "location": "external" },
    { "name": "size", "type": "decimal", "location": "external" },
    {
      "name": "event_time_basis",
      "type": "enum",
      "location": "internal",
      "variants": ["source", "receipt"]
    },
    { "name": "event_time", "type": "timestamp", "location": "internal" }
  ],
  "event_time_field": "event_time"
}
