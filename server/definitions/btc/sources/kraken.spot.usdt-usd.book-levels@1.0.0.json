{
  "schema_version": 1,
  "source_id": "kraken.spot.usdt-usd.book-levels",
  "version": "1.0.0",
  "name": "Kraken Spot USDT/USD level-two book levels",
  "description": "Checksum-gated Kraken Spot WebSocket v2 USDT/USD depth rows. The adapter applies provider rows in source order, truncates state to the configured depth, and emits any required depth eviction as an explicit zero-size row. Rows sharing update_group are one atomic message and are emitted only after the resulting top-ten book passes Kraken's CRC32 checksum.",
  "status": "approved",
  "transport": "websocket",
  "expected_heartbeat_ms": 1000,
  "fields": [
    { "name": "instrument", "type": "string", "location": "external" },
    { "name": "configured_depth", "type": "u16", "location": "internal" },
    { "name": "update_group", "type": "string", "location": "internal" },
    { "name": "update_index", "type": "u32", "location": "internal" },
    { "name": "update_count", "type": "u32", "location": "internal" },
    {
      "name": "update_kind",
      "type": "enum",
      "location": "internal",
      "variants": ["snapshot", "delta"]
    },
    {
      "name": "side",
      "type": "enum",
      "location": "internal",
      "variants": ["bid", "ask"]
    },
    { "name": "price", "type": "decimal", "location": "external" },
    { "name": "size", "type": "decimal", "location": "internal" },
    {
      "name": "change_origin",
      "type": "enum",
      "location": "internal",
      "variants": ["provider", "depth_eviction"]
    },
    { "name": "book_checksum", "type": "u32", "location": "external" },
    { "name": "event_time", "type": "timestamp", "location": "external" }
  ],
  "event_time_field": "event_time"
}
