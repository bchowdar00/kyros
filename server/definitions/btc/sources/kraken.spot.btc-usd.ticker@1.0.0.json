{
  "schema_version": 1,
  "source_id": "kraken.spot.btc-usd.ticker",
  "version": "1.0.0",
  "name": "Kraken Spot BTC/USD ticker",
  "description": "Normalized Kraken Spot WebSocket v2 BTC/USD best bid and ask, last price, and rolling 24-hour market statistics. This is a reference stream, not a substitute for checksum-gated book or trade state.",
  "status": "approved",
  "transport": "websocket",
  "expected_heartbeat_ms": 1000,
  "fields": [
    { "name": "instrument", "type": "string", "location": "external" },
    { "name": "best_bid", "type": "decimal", "location": "external" },
    { "name": "best_bid_size", "type": "decimal", "location": "external" },
    { "name": "best_ask", "type": "decimal", "location": "external" },
    { "name": "best_ask_size", "type": "decimal", "location": "external" },
    { "name": "last_price", "type": "decimal", "location": "external" },
    { "name": "volume_24h", "type": "decimal", "location": "external" },
    { "name": "vwap_24h", "type": "decimal", "location": "external" },
    { "name": "low_24h", "type": "decimal", "location": "external" },
    { "name": "high_24h", "type": "decimal", "location": "external" },
    { "name": "change_24h", "type": "decimal", "location": "external" },
    { "name": "change_percent_24h", "type": "decimal", "location": "external" },
    { "name": "trade_count_24h", "type": "u64", "location": "external" },
    {
      "name": "update_kind",
      "type": "enum",
      "location": "external",
      "variants": ["snapshot", "update"]
    },
    { "name": "event_time", "type": "timestamp", "location": "external" }
  ],
  "event_time_field": "event_time"
}
