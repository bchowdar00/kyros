{
  "schema_version": 1,
  "source_id": "kraken.spot.btc-usd.ohlc-1m",
  "version": "1.0.0",
  "name": "Kraken Spot BTC/USD one-minute OHLC",
  "description": "Normalized Kraken Spot WebSocket v2 BTC/USD one-minute OHLC updates. window_close identifies the candle boundary; event_time preserves the provider message timestamp and may precede the close of an in-progress candle.",
  "status": "approved",
  "transport": "websocket",
  "expected_heartbeat_ms": 1000,
  "fields": [
    { "name": "instrument", "type": "string", "location": "external" },
    { "name": "interval_minutes", "type": "u16", "location": "external" },
    { "name": "window_open", "type": "timestamp", "location": "external" },
    { "name": "window_close", "type": "timestamp", "location": "external" },
    { "name": "open", "type": "decimal", "location": "external" },
    { "name": "high", "type": "decimal", "location": "external" },
    { "name": "low", "type": "decimal", "location": "external" },
    { "name": "close", "type": "decimal", "location": "external" },
    { "name": "trade_count", "type": "u64", "location": "external" },
    { "name": "volume", "type": "decimal", "location": "external" },
    { "name": "vwap", "type": "decimal", "location": "external" },
    {
      "name": "update_kind",
      "type": "enum",
      "location": "external",
      "variants": ["snapshot", "update"]
    },
    { "name": "event_time", "type": "timestamp", "location": "external" }
  ],
  "event_time_field": "event_time"
}
