# Copy to `.env` (gitignored) and fill in. Loaded by dotenvy at startup.

# ─────────────────────────────────────────────────────────────────────────
# REQUIRED FOR LIVE PRICES: Pyth Pro (Lazer) access token.
#
# The exchange's BTC/USD price feed streams from Pyth Pro over WebSocket
# (three redundant nodes, real_time channel, ~1 ms updates). Generate a
# key in Pyth Terminal and share it via a secrets manager, never in chat
# or commits. Without it the server falls back to Coinbase's public
# ticker, which is fine for local development but slower and unmetered.
# ─────────────────────────────────────────────────────────────────────────
PYTH_PRO_API_KEY=

# OpenAI key for the natural-language strategy parser (Automate tab).
OPENAI_API_KEY=

# Log filter, e.g. `info` or `exchange=debug`.
RUST_LOG=info

# ─────────────────────────────────────────────────────────────────────────
# Writer meter: daily caps on the frontend's language-model calls, enforced
# here so a stranger cannot drain the owner's API credits. Days are UTC. An
# unparsable value is a boot error. One strategy build (repairs included) is
# one charge; one chat turn is one charge.
# ─────────────────────────────────────────────────────────────────────────
# WRITER_CAP_PER_GUEST_PER_DAY=8        # strategy builds, per anonymous guest
# WRITER_CAP_PER_ADDRESS_PER_DAY=20     # strategy builds, per account address
# WRITER_CAP_SITE_PER_DAY=300           # strategy builds, site-wide
# WRITER_CAP_CHAT_PER_GUEST_PER_DAY=40  # chat turns, per anonymous guest
# WRITER_CAP_CHAT_SITE_PER_DAY=2000     # chat turns, site-wide
# Shared secret the Next.js server sends as `x-writer-token`. REQUIRED for
# the writer to work: while it is unset the meter is closed and every writer
# route answers 503, so chat and strategy builds are unavailable (templates
# still deploy). Set it here and set the SAME value as WRITER_METER_TOKEN in
# the front end's env so only the Next server can charge the meter.
# WRITER_METER_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# BTC signal producers (spot / prediction / venue lanes), run in-process
# on their own threads. On by default; every lane writes hour-long file
# generations under SIGNALS_LANE_ROOT/<lane>/.
# ─────────────────────────────────────────────────────────────────────────
# SIGNALS_ENABLED=1                 # 0 / false / off disables every lane
# SIGNALS_LANE_ROOT=signals-data    # relative to the server's working dir
# SIGNALS_ROTATE_SECONDS=3600       # generation rotation period (>= 60)
# SIGNALS_KEEP_GENERATIONS=3       # generations kept per lane by the in-process retention sweep (>= 2)
# Allow-list of venues. Default: coinbase,kalshi,kraken,polymarket. With the
# default, the spot lane (Coinbase + Kraken, no keys) and the Polymarket lane
# (no keys) run; the Kalshi lane also needs the two credentials below. Add
# binance / bybit / oracle to opt those lanes in (cross needs bybit too).
# SIGNALS_ENABLED_VENUES=coinbase,kalshi,kraken,polymarket
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
# PYTH_API_KEY=                     # Pyth Hermes key for the oracle lane's index socket
# CHAINLINK_RPC_ENDPOINTS=          # comma-separated; public defaults when unset

# ─────────────────────────────────────────────────────────────────────────
# Venue registry. Generated at every start-up from the series table and
# the signal definition tree (definitions/<underlying>/signals) in the strategy
# compiler's format, written to REGISTRY_PATH and served at /api/registry.
# Nothing here is hand-maintained.
# ─────────────────────────────────────────────────────────────────────────
# REGISTRY_PATH=registry.json                        # relative to the working dir
# SIGNALS_DEFINITIONS_DIR=definitions    # root; auto-found in the checkout when unset

# Optional tuning. Defaults live in the code.
# MM_BANKROLL_USD=            # market-maker bankroll, all series
# MM_BANKROLL_USD_BTC_2M=     # per-series override (slug upper-cased, dashes → underscores)
# TRADER_BOT_COUNT_BTC_2M=    # trader cohort size per series
# PORT=8080
