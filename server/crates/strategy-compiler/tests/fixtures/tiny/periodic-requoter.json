{
  "meta": {
    "name": "Periodic Requoter",
    "description": "On the one-minute BTC up/down: when the ask on up sits at least 3 cents under fair (checked at most every 2 seconds), rest a bid one cent under fair. While resting, re-quote the bid every 2 seconds to track fair; give up 20 seconds after the bid was placed, or with 10 seconds left in the window, whichever comes first.",
    "dsl_version": "0.3"
  },

  "instruments": {
    "market": "btc_usd.updown_1m.current"
  },

  "signals": {
    "book": "btc_usd.updown_1m.current.price.v1",
    "fair": "platform.btc_usd.updown_1m.current.fair.v1"
  },

  "state": [],

  "triggers": [
    { "name": "cheap",
      "condition": { "expr": "signal.fair.up - signal.book.ask", "comparator": ">=", "value": "0.03" },
      "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "2s" } },

    { "name": "every_2s",
      "timer": { "kind": "interval", "every": "2s" },
      "fire": "on_crossing", "rearm": { "mode": "immediate" } },

    { "name": "give_up",
      "timer": { "kind": "after", "elapsed": "20s" },
      "fire": "on_crossing", "rearm": { "mode": "never" } },

    { "name": "last_10s",
      "timer": { "kind": "window_clock", "instrument": "market", "remaining": "10s" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } }
  ],

  "legs": [
    { "name": "hunting",
      "resident": true,
      "arm": ["cheap", "last_10s"],
      "body": [
        { "name": "bid_up",
          "if": "triggered(cheap)",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "gtc",
                "price": "clamp(signal.fair.up - 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(envelope.max_order_size, 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "bid",
                "on": { "fill": "done", "reject": "hunting" }
            }}
          ],
          "then": "quoting" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "quoting",
      "resident": true,
      "arm": ["every_2s", "give_up", "last_10s"],
      "body": [
        { "name": "requote",
          "if": "triggered(every_2s)",
          "do": [
            { "cancel_replace": {
                "tag": "bid",
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "gtc",
                "price": "clamp(signal.fair.up - 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(envelope.max_order_size, 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size"
            }}
          ] },

        { "name": "bail",
          "if": "triggered(give_up) or triggered(last_10s)",
          "do": [ { "cancel": { "tag": "bid" } } ],
          "then": "done" }
      ] },

    { "name": "done", "resident": true, "arm": [], "body": [] }
  ]
}
