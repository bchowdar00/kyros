{
  "meta": {
    "name": "Re-Entry",
    "description": "On the one-minute BTC up/down: when the up price crosses above 60 cents, buy up at once with a quarter of the round budget. While holding, sell the whole position at market once the bid is 5 cents above the average entry, or cut the loss when it falls 10 cents below; either way go back to hunting and wait for the next crossing above 60 cents. At most three entries per round. Ten seconds before the close, stop and hold whatever is open to settlement.",
    "dsl_version": "0.3"
  },

  "instruments": {
    "market": "btc_usd.updown_1m.current"
  },

  "signals": {
    "book": "btc_usd.updown_1m.current.price.v1"
  },

  "state": [
    { "name": "entries", "kind": "scalar", "value_type": "u8" }
  ],

  "triggers": [
    { "name": "up_rich",
      "condition": { "signal": "book", "field": "up", "comparator": ">", "value": "0.6" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } },

    { "name": "book_tick",
      "condition": { "signal": "book" },
      "fire": "if_true", "rearm": { "mode": "immediate" } },

    { "name": "last_10s",
      "timer": { "kind": "window_clock", "instrument": "market", "remaining": "10s" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } }
  ],

  "legs": [
    { "name": "hunting",
      "resident": true,
      "arm": ["up_rich", "last_10s"],
      "body": [
        { "name": "buy_up",
          "if": "triggered(up_rich) and state.entries < 3",
          "do": [
            "set state.entries = state.entries + 1",
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "ioc",
                "price": "clamp(signal.book.ask + 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(floor(envelope.round_budget * 0.25 / (signal.book.ask + 0.01)), 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "entry",
                "on": { "reject": "hunting", "expiry": "hunting" }
            }}
          ],
          "then": "holding" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "holding",
      "resident": true,
      "arm": ["book_tick", "last_10s"],
      "body": [
        { "name": "take_profit",
          "if": "triggered(book_tick) and platform.position.size > 0 and signal.book.bid >= platform.position.avg_cost + 0.05",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "up", "side": "sell",
                "order_type": "market", "tif": "ioc",
                "reduce_only": true,
                "size": "clamp(abs(platform.position.size), 0, envelope.max_position_per_market)",
                "max_size": "envelope.max_position_per_market",
                "tag": "exit"
            }}
          ],
          "then": "hunting" },

        { "name": "cut_loss",
          "if": "triggered(book_tick) and platform.position.size > 0 and signal.book.bid <= platform.position.avg_cost - 0.1",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "up", "side": "sell",
                "order_type": "market", "tif": "ioc",
                "reduce_only": true,
                "size": "clamp(abs(platform.position.size), 0, envelope.max_position_per_market)",
                "max_size": "envelope.max_position_per_market",
                "tag": "stop"
            }}
          ],
          "then": "hunting" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "done", "resident": true, "arm": [], "body": [] }
  ]
}
