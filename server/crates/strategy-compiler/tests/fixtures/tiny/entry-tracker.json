{
  "meta": {
    "name": "Entry Tracker",
    "description": "On the one-minute BTC up/down: when the ask on up sits at least 4 cents under fair, buy up with an immediate limit a cent over the ask, spending half the round budget, and remember the ask as the entry price. Once holding, sell the whole position at market as soon as the bid on up is 5 cents above the remembered entry.",
    "dsl_version": "0.3"
  },

  "instruments": {
    "market": "btc_usd.updown_1m.current"
  },

  "signals": {
    "book": "btc_usd.updown_1m.current.price.v1",
    "fair": "platform.btc_usd.updown_1m.current.fair.v1"
  },

  "state": [
    { "name": "entry_px", "kind": "scalar", "value_type": "decimal" },
    { "name": "holding", "kind": "scalar", "value_type": "bool" }
  ],

  "triggers": [
    { "name": "cheap",
      "condition": { "all": [
        { "signal": "book", "field": "ask", "comparator": ">", "value": "0" },
        { "signal": "fair", "field": "up", "comparator": ">", "value": "0" }
      ]},
      "fire": "if_true", "rearm": { "mode": "immediate" } },

    { "name": "book_tick",
      "condition": { "signal": "book" },
      "fire": "if_true", "rearm": { "mode": "immediate" } }
  ],

  "legs": [
    { "name": "hunting",
      "resident": true,
      "arm": ["cheap"],
      "body": [
        { "name": "buy_up",
          "if": "triggered(cheap) and signal.fair.up - signal.book.ask >= 0.04",
          "do": [
            "set state.entry_px = signal.book.ask",
            "set state.holding = true",
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "ioc",
                "price": "clamp(signal.book.ask + 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(floor(envelope.round_budget * 0.5 / (signal.book.ask + 0.01)), 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "entry",
                "on": { "reject": "hunting" }
            }}
          ],
          "then": "holding" }
      ] },

    { "name": "holding",
      "resident": true,
      "arm": ["book_tick"],
      "body": [
        { "name": "take_profit",
          "if": "triggered(book_tick) and state.holding and signal.book.bid >= state.entry_px + 0.05",
          "do": [
            "set state.holding = false",
            { "place": {
                "instrument": "market", "outcome": "up", "side": "sell",
                "order_type": "market", "tif": "ioc",
                "reduce_only": true,
                "size": "clamp(abs(platform.position.size), 0, envelope.max_position_per_market)",
                "max_size": "envelope.max_position_per_market",
                "tag": "exit",
                "on": { "reject": "holding" }
            }}
          ],
          "then": "done" }
      ] },

    { "name": "done", "resident": true, "arm": [], "body": [] }
  ]
}
