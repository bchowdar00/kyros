{
  "meta": {
    "name": "Fair Discount",
    "description": "On the one-minute BTC up/down: whenever the book's ask on up sits at least 4 cents under the platform's fair probability, buy up at one cent under fair with a resting limit. Requote if fair moves while the bid rests. With 10 seconds left, pull the bid and stop for the window.",
    "dsl_version": "0.3"
  },

  "instruments": {
    "market": "btc_usd.updown_1m.current"
  },

  "signals": {
    "book": "btc_usd.updown_1m.current.price.v1",
    "fair": "platform.btc_usd.updown_1m.current.fair.v1"
  },

  "state": [
    { "name": "quotes", "kind": "scalar", "value_type": "u8" }
  ],

  "triggers": [
    { "name": "cheap",
      "condition": { "expr": "signal.fair.up - signal.book.ask", "comparator": ">=", "value": "0.04" },
      "fire": "if_true", "rearm": { "mode": "immediate" } },

    { "name": "fair_moved",
      "condition": { "signal": "fair" },
      "fire": "if_true", "rearm": { "mode": "immediate" } },

    { "name": "last_10s",
      "timer": { "kind": "window_clock", "instrument": "market", "remaining": "10s" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } }
  ],

  "legs": [
    { "name": "hunting",
      "resident": true,
      "arm": ["cheap", "last_10s"],
      "body": [
        { "name": "bid_up",
          "if": "triggered(cheap)",
          "do": [
            "set state.quotes = state.quotes + 1",
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "gtc",
                "price": "clamp(signal.fair.up - 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(envelope.max_order_size, 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "bid",
                "on": { "fill": "done", "reject": "hunting" }
            }}
          ],
          "then": "quoting" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "quoting",
      "resident": true,
      "arm": ["fair_moved", "last_10s"],
      "body": [
        { "name": "requote",
          "if": "triggered(fair_moved)",
          "do": [
            { "cancel_replace": {
                "tag": "bid",
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "gtc",
                "price": "clamp(signal.fair.up - 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(envelope.max_order_size, 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size"
            }}
          ] },

        { "name": "pull",
          "if": "triggered(last_10s)",
          "do": [ { "cancel": { "tag": "bid" } } ],
          "then": "done" }
      ] },

    { "name": "done", "resident": true, "arm": [], "body": [] }
  ]
}
