{
  "meta": {
    "name": "Momentum Flip",
    "description": "On the one-minute BTC up/down: when either side's price crosses above 70 cents, buy that side at once with half the round budget. While holding, if the held side's price falls below 50 cents, flip: sell the whole position at market (reduce-only) and buy the other side with the dollars just released. The flip trigger for each side is armed only while that side is held, so the strategy flips on the way down and never on the way up. Ten seconds before the close, stop trading and hold to settlement.",
    "dsl_version": "0.3"
  },

  "instruments": {
    "market": "btc_usd.updown_1m.current"
  },

  "signals": {
    "book": "btc_usd.updown_1m.current.price.v1"
  },

  "state": [],

  "triggers": [
    { "name": "up_rich",
      "condition": { "signal": "book", "field": "up", "comparator": ">", "value": "0.7" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } },

    { "name": "down_rich",
      "condition": { "signal": "book", "field": "down", "comparator": ">", "value": "0.7" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } },

    { "name": "up_cheap",
      "condition": { "signal": "book", "field": "up", "comparator": "<", "value": "0.5" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } },

    { "name": "down_cheap",
      "condition": { "signal": "book", "field": "down", "comparator": "<", "value": "0.5" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } },

    { "name": "last_10s",
      "timer": { "kind": "window_clock", "instrument": "market", "remaining": "10s" },
      "fire": "on_crossing", "rearm": { "mode": "fresh_crossing" } }
  ],

  "legs": [
    { "name": "hunting",
      "resident": true,
      "arm": ["up_rich", "down_rich", "last_10s"],
      "body": [
        { "name": "buy_up",
          "if": "triggered(up_rich)",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "ioc",
                "price": "clamp(signal.book.ask + 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(floor(envelope.round_budget * 0.5 / (signal.book.ask + 0.01)), 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "entry",
                "on": { "reject": "hunting", "expiry": "hunting" }
            }}
          ],
          "then": "holding_up" },

        { "name": "buy_down",
          "if": "triggered(down_rich)",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "down", "side": "buy",
                "order_type": "limit", "tif": "ioc",
                "price": "clamp(1 - signal.book.bid + 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(floor(envelope.round_budget * 0.5 / (1 - signal.book.bid + 0.01)), 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "entry",
                "on": { "reject": "hunting", "expiry": "hunting" }
            }}
          ],
          "then": "holding_down" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "holding_up",
      "resident": true,
      "arm": ["up_cheap", "last_10s"],
      "body": [
        { "name": "flip_to_down",
          "if": "triggered(up_cheap) and platform.position.size > 0",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "up", "side": "sell",
                "order_type": "market", "tif": "ioc",
                "reduce_only": true,
                "size": "clamp(abs(platform.position.size), 0, envelope.max_position_per_market)",
                "max_size": "envelope.max_position_per_market",
                "tag": "flatten"
            }},
            { "place": {
                "instrument": "market", "outcome": "down", "side": "buy",
                "order_type": "limit", "tif": "ioc",
                "price": "clamp(1 - signal.book.bid + 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(floor(abs(platform.position.size) * platform.position.avg_cost / (1 - signal.book.bid + 0.01)), 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "flip",
                "on": { "reject": "hunting", "expiry": "hunting" }
            }}
          ],
          "then": "holding_down" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "holding_down",
      "resident": true,
      "arm": ["down_cheap", "last_10s"],
      "body": [
        { "name": "flip_to_up",
          "if": "triggered(down_cheap) and platform.position.size < 0",
          "do": [
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "market", "tif": "ioc",
                "reduce_only": true,
                "size": "clamp(abs(platform.position.size), 0, envelope.max_position_per_market)",
                "max_size": "envelope.max_position_per_market",
                "tag": "flatten"
            }},
            { "place": {
                "instrument": "market", "outcome": "up", "side": "buy",
                "order_type": "limit", "tif": "ioc",
                "price": "clamp(signal.book.ask + 0.01, 0.01, 0.99)",
                "price_band": ["0.01", "0.99"],
                "size": "clamp(floor(abs(platform.position.size) * (1 - platform.position.avg_cost) / (signal.book.ask + 0.01)), 0, envelope.max_order_size)",
                "max_size": "envelope.max_order_size",
                "tag": "flip",
                "on": { "reject": "hunting", "expiry": "hunting" }
            }}
          ],
          "then": "holding_up" },

        { "name": "stop",
          "if": "triggered(last_10s)",
          "do": [],
          "then": "done" }
      ] },

    { "name": "done", "resident": true, "arm": [], "body": [] }
  ]
}
