{
  "schema_version": 2,
  "strategy_id": "Strategy_b8c1d409b72e",
  "name": "Favorite Panic",
  "description": "On the NBA moneyline: the pregame Pinnacle line decides who the favorite is. First half only — if the favorite is down by 10 or more, the opponent has made 5 or more threes in the current quarter, and the favorite's price is under 35 cents, buy the favorite (the deficit is hot-shooting variance and usually comes back). After entry: sell if the favorite recovers past 70 cents; if it keeps dying and drops under 15 cents, sell anyway and eat the loss.",
  "dsl_version": "0.3",
  "source_hash": "b8c1d409b72ecc7cb1fa461fa6a81509680cde6eab899896fc08a23f1d5d2c51",
  "signals": [
    {
      "signal_id": "pinnacle.nba.sim.h2h.current.fair.v1",
      "staleness_policy": "proceed"
    },
    {
      "signal_id": "nba.sim.h2h.current.pbp.v1",
      "staleness_policy": "proceed"
    },
    {
      "signal_id": "nba.sim.h2h.current.price.v1",
      "staleness_policy": "proceed"
    }
  ],
  "watch_fields": [
    {
      "signal_id": "nba.sim.h2h.current.pbp.v1",
      "field": "action"
    },
    {
      "signal_id": "nba.sim.h2h.current.pbp.v1",
      "field": "away_score"
    },
    {
      "signal_id": "nba.sim.h2h.current.pbp.v1",
      "field": "home_score"
    },
    {
      "signal_id": "nba.sim.h2h.current.pbp.v1",
      "field": "quarter"
    },
    {
      "signal_id": "nba.sim.h2h.current.pbp.v1",
      "field": "result"
    },
    {
      "signal_id": "nba.sim.h2h.current.price.v1",
      "field": "away"
    },
    {
      "signal_id": "nba.sim.h2h.current.price.v1",
      "field": "home"
    },
    {
      "signal_id": "pinnacle.nba.sim.h2h.current.fair.v1",
      "field": "home"
    }
  ],
  "triggers": [
    {
      "id": "opening_line",
      "condition": {
        "signal_id": "pinnacle.nba.sim.h2h.current.fair.v1",
        "comparator": "always"
      },
      "fire": "if_true",
      "rearm": {
        "mode": "never"
      }
    },
    {
      "id": "made_three",
      "condition": {
        "all": [
          {
            "signal_id": "nba.sim.h2h.current.pbp.v1",
            "field": "action",
            "comparator": "==",
            "value": "three_pointer"
          },
          {
            "signal_id": "nba.sim.h2h.current.pbp.v1",
            "field": "result",
            "comparator": "==",
            "value": "made"
          }
        ]
      },
      "fire": "if_true",
      "rearm": {
        "mode": "immediate"
      }
    },
    {
      "id": "home_panic",
      "condition": {
        "all": [
          {
            "signal_id": "nba.sim.h2h.current.price.v1",
            "field": "home",
            "comparator": "<",
            "value": "0.35"
          },
          {
            "signal_id": "nba.sim.h2h.current.pbp.v1",
            "expr": {
              "op": "-",
              "lhs": {
                "field": "away_score"
              },
              "rhs": {
                "field": "home_score"
              }
            },
            "comparator": ">=",
            "value": "10"
          },
          {
            "signal_id": "nba.sim.h2h.current.pbp.v1",
            "field": "quarter",
            "comparator": "<=",
            "value": "2"
          }
        ]
      },
      "fire": "if_true",
      "rearm": {
        "mode": "immediate"
      }
    },
    {
      "id": "away_panic",
      "condition": {
        "all": [
          {
            "signal_id": "nba.sim.h2h.current.price.v1",
            "field": "away",
            "comparator": "<",
            "value": "0.35"
          },
          {
            "signal_id": "nba.sim.h2h.current.pbp.v1",
            "expr": {
              "op": "-",
              "lhs": {
                "field": "home_score"
              },
              "rhs": {
                "field": "away_score"
              }
            },
            "comparator": ">=",
            "value": "10"
          },
          {
            "signal_id": "nba.sim.h2h.current.pbp.v1",
            "field": "quarter",
            "comparator": "<=",
            "value": "2"
          }
        ]
      },
      "fire": "if_true",
      "rearm": {
        "mode": "immediate"
      }
    },
    {
      "id": "home_recovered",
      "condition": {
        "signal_id": "nba.sim.h2h.current.price.v1",
        "field": "home",
        "comparator": ">",
        "value": "0.7"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    },
    {
      "id": "home_dead",
      "condition": {
        "signal_id": "nba.sim.h2h.current.price.v1",
        "field": "home",
        "comparator": "<",
        "value": "0.15"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    },
    {
      "id": "away_recovered",
      "condition": {
        "signal_id": "nba.sim.h2h.current.price.v1",
        "field": "away",
        "comparator": ">",
        "value": "0.7"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    },
    {
      "id": "away_dead",
      "condition": {
        "signal_id": "nba.sim.h2h.current.price.v1",
        "field": "away",
        "comparator": "<",
        "value": "0.15"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    }
  ],
  "lifecycle_stages": [
    {
      "name": "hunting",
      "resident": true,
      "arm": [
        "opening_line",
        "made_three",
        "home_panic",
        "away_panic"
      ]
    },
    {
