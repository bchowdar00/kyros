---
source: crates/strategy-compiler/tests/emit_manifest.rs
expression: manifest
---
{
  "schema_version": 2,
  "strategy_id": "Strategy_1ee8ef1c2415",
  "name": "Break Quoter",
  "description": "On the NBA moneyline: quote both sides with a tight spread only while play is stopped — quarter breaks and halftime — where the price cannot move but people still want to trade. Place a bid 2 cents under and an ask 2 cents over the home mid when a break starts; the moment play resumes, cancel everything immediately. Never quotes during live play. When a game ends, pull any quotes and wait for the next game's breaks.",
  "dsl_version": "0.3",
  "source_hash": "1ee8ef1c2415bcc34b3ffb1b8f477dc972d4329dce06cf08aac5a9b65500c10f",
  "signals": [
    {
      "signal_id": "nba.sim.h2h.current.price.v1",
      "staleness_policy": "proceed"
    },
    {
      "signal_id": "nba.sim.h2h.current.game_state.v1",
      "staleness_policy": "proceed"
    }
  ],
  "watch_fields": [
    {
      "signal_id": "nba.sim.h2h.current.game_state.v1",
      "field": "phase"
    },
    {
      "signal_id": "nba.sim.h2h.current.price.v1",
      "field": "home"
    }
  ],
  "triggers": [
    {
      "id": "break_started",
      "condition": {
        "any": [
          {
            "signal_id": "nba.sim.h2h.current.game_state.v1",
            "field": "phase",
            "comparator": "==",
            "value": "break"
          },
          {
            "signal_id": "nba.sim.h2h.current.game_state.v1",
            "field": "phase",
            "comparator": "==",
            "value": "halftime"
          }
        ]
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    },
    {
      "id": "play_resumed",
      "condition": {
        "signal_id": "nba.sim.h2h.current.game_state.v1",
        "field": "phase",
        "comparator": "==",
        "value": "live"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    },
    {
      "id": "game_over",
      "condition": {
        "signal_id": "nba.sim.h2h.current.game_state.v1",
        "field": "phase",
        "comparator": "==",
        "value": "final"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    }
  ],
  "lifecycle_stages": [
    {
      "name": "watching",
      "resident": true,
      "arm": [
        "break_started"
      ]
    },
    {
      "name": "quoting",
      "resident": true,
      "arm": [
        "play_resumed",
        "game_over"
      ]
    }
  ],
  "intent_index": {
    "watching.start_quoting.0": {
      "on": {
        "fill": "stay",
        "partial": "stay",
        "reject": "stay",
        "cancel_ack": "stay",
        "expiry": "stay"
      },
      "max_size": "100"
    },
    "watching.start_quoting.1": {
      "on": {
        "fill": "stay",
        "partial": "stay",
        "reject": "stay",
        "cancel_ack": "stay",
        "expiry": "stay"
      },
      "max_size": "100"
    }
  },
  "envelope": {
    "allocation": "1000",
    "loss_budget": "500",
    "round_budget": "400",
    "max_order_size": "100",
    "max_position_per_market": "200",
    "max_open_orders": "8"
  }
}
