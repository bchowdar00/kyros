{
  "schema_version": 2,
  "strategy_id": "Strategy_a3e1cbbee7e3",
  "name": "Momentum Flip",
  "description": "On the 2-minute BTC up/down market: when either side's price rises above 75 cents, buy that side at half max size. While holding, if the held side's price falls below 40 cents, flip the position by buying the opposite side at double size (one order flips sides on the unified book). If an entry or flip order is rejected, return to the prior mode.",
  "dsl_version": "0.3",
  "source_hash": "a3e1cbbee7e3cbdce1035d0d53d5d4ace9820f8b50cb65fe267253bfef1c32ca",
  "signals": [
    {
      "signal_id": "btc_usd.updown_2m.current.price.v1",
      "staleness_policy": "proceed"
    }
  ],
  "watch_fields": [
    {
      "signal_id": "btc_usd.updown_2m.current.price.v1",
      "field": "down"
    },
    {
      "signal_id": "btc_usd.updown_2m.current.price.v1",
      "field": "up"
    }
  ],
  "triggers": [
    {
      "id": "up_rich",
      "condition": {
        "signal_id": "btc_usd.updown_2m.current.price.v1",
        "field": "up",
        "comparator": ">",
        "value": "0.75"
      },
      "fire": "on_crossing",
      "rearm": {
        "mode": "fresh_crossing"
      }
    },
    {
      "id": "down_rich",
      "condition": {
        "signal_id": "btc_usd.updown_2m.current.price.v1",
        "field": "down",
