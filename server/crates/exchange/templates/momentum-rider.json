{
  "id": "momentum-rider",
  "title": "Flash Move",
  "creator": { "handle": "@tiny", "username": "Tiny", "avatar": "strategy-02.jpg" },
  "series": ["btc-5m", "btc-15m"],
  "logic": "When BTC jumps in the last ten seconds and the buying or selling behind it is still pushing, it bets the move keeps going: Up after a jump up, Down after a jump down. One trade per round, held to the close.",
  "inverse_logic": "When BTC jumps in the last ten seconds and then stalls, it bets the move comes back: Down after a jump up, Up after a jump down. Sells out after a four-cent gain, otherwise holds to the close.",
  "envelope": { "loss_budget_fraction": "1", "order_fraction": "0.2", "max_order_size": "200", "max_open_orders": "1", "max_position_per_market": "400" },
  "substitutions": {
    "btc-5m": { "min_return_bps": "3", "stall_bps": "1", "gain": "0.04", "cutoff": "20s", "check": "1s", "patience": "30s" },
    "btc-15m": { "min_return_bps": "6", "stall_bps": "2", "gain": "0.04", "cutoff": "90s", "check": "2s", "patience": "45s" }
  },
  "primary": {
    "meta": {
      "name": "Chase the Burst",
      "description": "When the blended ten-second BTC return is at least the threshold in either direction and the ten-second aggressor flow agrees, take that side with an immediate-or-cancel limit two cents over the ask, once per round, and hold to settlement. No entries inside the cutoff before the close.",
      "dsl_version": "0.3"
    },
    "instruments": { "market": "{{series}}.current" },
    "signals": {
      "book": "{{series}}.current.price.v1",
      "mom": "btc.external.micro_momentum.v1",
      "flow": "btc.external.aggressor_flow.v1"
    },
    "state": [],
    "triggers": [
      { "name": "burst_up",
        "condition": { "all": [
          { "expr": "signal.mom.return_bps_10s", "comparator": ">=", "value": "{{min_return_bps}}" },
          { "signal": "mom", "field": "direction_10s", "comparator": "==", "value": "up" },
          { "signal": "flow", "field": "flow_direction_10s", "comparator": "==", "value": "buy" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "burst_down",
        "condition": { "all": [
          { "expr": "0 - signal.mom.return_bps_10s", "comparator": ">=", "value": "{{min_return_bps}}" },
          { "signal": "mom", "field": "direction_10s", "comparator": "==", "value": "down" },
          { "signal": "flow", "field": "flow_direction_10s", "comparator": "==", "value": "sell" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } }
    ],
    "legs": [
      { "name": "hunting", "resident": true, "arm": ["burst_up", "burst_down"],
        "body": [
          { "name": "take_up",
            "if": "triggered(burst_up) and platform.window.remaining_ms > {{cutoff}} and signal.book.ask < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "up", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp(signal.book.ask + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / signal.book.ask, 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "take_up",
                  "on": { "fill": "holding", "partial": "holding", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding" },
          { "name": "take_down",
            "if": "triggered(burst_down) and platform.window.remaining_ms > {{cutoff}} and 1 - signal.book.bid < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "down", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp((1 - signal.book.bid) + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / (1 - signal.book.bid), 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "take_down",
                  "on": { "fill": "holding", "partial": "holding", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding" }
        ] },
      { "name": "holding", "resident": true, "arm": [], "body": [] }
    ]
  },
  "inverse": {
    "meta": {
      "name": "Fade the Burst",
      "description": "On a ten-second burst with agreeing aggressor flow, wait for it to stall: the ten-second return back inside the stall band. Then take the other side with an immediate-or-cancel limit two cents over the ask. Sell out with an immediate-or-cancel once that side's bid is the gain above the entry, else hold to settlement. A burst that does not stall within the patience window is abandoned.",
      "dsl_version": "0.3"
    },
    "instruments": { "market": "{{series}}.current" },
    "signals": {
      "book": "{{series}}.current.price.v1",
      "mom": "btc.external.micro_momentum.v1",
      "flow": "btc.external.aggressor_flow.v1"
    },
    "state": [],
    "triggers": [
      { "name": "burst_up",
        "condition": { "all": [
          { "expr": "signal.mom.return_bps_10s", "comparator": ">=", "value": "{{min_return_bps}}" },
          { "signal": "mom", "field": "direction_10s", "comparator": "==", "value": "up" },
          { "signal": "flow", "field": "flow_direction_10s", "comparator": "==", "value": "buy" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "burst_down",
        "condition": { "all": [
          { "expr": "0 - signal.mom.return_bps_10s", "comparator": ">=", "value": "{{min_return_bps}}" },
          { "signal": "mom", "field": "direction_10s", "comparator": "==", "value": "down" },
          { "signal": "flow", "field": "flow_direction_10s", "comparator": "==", "value": "sell" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "stalled",
        "condition": { "expr": "abs(signal.mom.return_bps_10s)", "comparator": "<=", "value": "{{stall_bps}}" },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "gave_up",
        "timer": { "kind": "after", "elapsed": "{{patience}}" },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "tick",
        "condition": { "signal": "book" },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "{{check}}" } }
    ],
    "legs": [
      { "name": "hunting", "resident": true, "arm": ["burst_up", "burst_down"],
        "body": [
          { "name": "saw_up", "if": "triggered(burst_up) and platform.window.remaining_ms > {{cutoff}}", "do": [], "then": "after_up" },
          { "name": "saw_down", "if": "triggered(burst_down) and platform.window.remaining_ms > {{cutoff}}", "do": [], "then": "after_down" }
        ] },
      { "name": "after_up", "resident": true, "arm": ["stalled", "gave_up"],
        "body": [
          { "name": "fade_down",
            "if": "triggered(stalled) and platform.window.remaining_ms > {{cutoff}} and 1 - signal.book.bid < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "down", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp((1 - signal.book.bid) + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / (1 - signal.book.bid), 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "fade_down",
                  "on": { "fill": "holding_down", "partial": "holding_down", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding_down" },
          { "name": "abandon", "if": "triggered(gave_up)", "do": [], "then": "hunting" }
        ] },
      { "name": "after_down", "resident": true, "arm": ["stalled", "gave_up"],
        "body": [
          { "name": "fade_up",
            "if": "triggered(stalled) and platform.window.remaining_ms > {{cutoff}} and signal.book.ask < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "up", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp(signal.book.ask + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / signal.book.ask, 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "fade_up",
                  "on": { "fill": "holding_up", "partial": "holding_up", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding_up" },
          { "name": "abandon", "if": "triggered(gave_up)", "do": [], "then": "hunting" }
        ] },
      { "name": "holding_down", "resident": true, "arm": ["tick"],
        "body": [
          { "name": "take_profit",
            "if": "triggered(tick) and platform.position.size <= -1 and 1 - signal.book.ask >= legs.after_up.tag.fade_down.fill_price + {{gain}}",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "up", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp(signal.book.ask + 0.01, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(abs(platform.position.size), 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "exit",
                  "on": { "fill": "done", "partial": "holding_down", "reject": "holding_down", "cancel_ack": "holding_down", "expiry": "holding_down" }
              } }
            ],
            "then": "done" }
        ] },
      { "name": "holding_up", "resident": true, "arm": ["tick"],
        "body": [
          { "name": "take_profit",
            "if": "triggered(tick) and platform.position.size >= 1 and signal.book.bid >= legs.after_down.tag.fade_up.fill_price + {{gain}}",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "down", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp((1 - signal.book.bid) + 0.01, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(platform.position.size, 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "exit",
                  "on": { "fill": "done", "partial": "holding_up", "reject": "holding_up", "cancel_ack": "holding_up", "expiry": "holding_up" }
              } }
            ],
            "then": "done" }
        ] },
      { "name": "done", "resident": true, "arm": [], "body": [] }
    ]
  }
}
