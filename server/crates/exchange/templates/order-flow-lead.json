{
  "id": "order-flow-lead",
  "title": "Order Stack",
  "creator": { "handle": "@tiny", "username": "Tiny", "avatar": "strategy-05.jpg" },
  "series": ["btc-2m", "btc-15m"],
  "logic": "Watches the Coinbase and Kraken order books. When one side is filling up faster and has more size waiting near the price, traders are lining up before they trade. It bets with them: Up when bids are stacking, Down when asks are. One trade per round, held to the close.",
  "inverse_logic": "Watches the Coinbase and Kraken order books. When one side is stacking up but our price has already moved past sixty cents that way, the move is priced in and only the queue is left. It buys the other side. Sells out after a four-cent gain, otherwise holds to the close.",
  "envelope": { "loss_budget_fraction": "1", "order_fraction": "0.2", "max_order_size": "200", "max_open_orders": "1", "max_position_per_market": "400" },
  "substitutions": {
    "btc-2m": { "cutoff": "20s", "min_flow_base": "2", "min_depth_imbalance": "0.2", "rich": "0.6", "gain": "0.04", "check": "1s" },
    "btc-15m": { "cutoff": "90s", "min_flow_base": "2", "min_depth_imbalance": "0.2", "rich": "0.6", "gain": "0.04", "check": "2s" }
  },
  "primary": {
    "meta": {
      "name": "Follow the Queue",
      "description": "When the blended ten-second order-flow imbalance is at least the flow threshold in either direction and the combined depth imbalance near the touch agrees by at least the depth threshold, take that side with an immediate-or-cancel limit two cents over the ask, once per round, and hold to settlement. No entries inside the cutoff before the close.",
      "dsl_version": "0.3"
    },
    "instruments": { "market": "{{series}}.current" },
    "signals": {
      "book": "{{series}}.current.price.v1",
      "ofi": "btc.external.order_flow_imbalance.v1",
      "depth": "btc.external.actionable_depth_imbalance.v1"
    },
    "state": [],
    "triggers": [
      { "name": "bids_building",
        "condition": { "all": [
          { "expr": "signal.ofi.ofi_base_10s", "comparator": ">=", "value": "{{min_flow_base}}" },
          { "expr": "signal.depth.combined_imbalance", "comparator": ">=", "value": "{{min_depth_imbalance}}" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "asks_building",
        "condition": { "all": [
          { "expr": "0 - signal.ofi.ofi_base_10s", "comparator": ">=", "value": "{{min_flow_base}}" },
          { "expr": "0 - signal.depth.combined_imbalance", "comparator": ">=", "value": "{{min_depth_imbalance}}" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } }
    ],
    "legs": [
      { "name": "hunting", "resident": true, "arm": ["bids_building", "asks_building"],
        "body": [
          { "name": "take_up",
            "if": "triggered(bids_building) and platform.window.remaining_ms > {{cutoff}} and signal.book.ask < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "up", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp(signal.book.ask + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / signal.book.ask, 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "take_up",
                  "on": { "fill": "holding", "partial": "holding", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding" },
          { "name": "take_down",
            "if": "triggered(asks_building) and platform.window.remaining_ms > {{cutoff}} and 1 - signal.book.bid < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "down", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp((1 - signal.book.bid) + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / (1 - signal.book.bid), 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "take_down",
                  "on": { "fill": "holding", "partial": "holding", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding" }
        ] },
      { "name": "holding", "resident": true, "arm": [], "body": [] }
    ]
  },
  "inverse": {
    "meta": {
      "name": "Fade the Queue",
      "description": "When the blended ten-second order-flow imbalance and the depth imbalance near the touch are one-sided and our book already prices that side at or above the rich level, take the other side with an immediate-or-cancel limit two cents over the ask. Sell out with an immediate-or-cancel once that side's bid is the gain above the entry, else hold to settlement. No entries inside the cutoff before the close.",
      "dsl_version": "0.3"
    },
    "instruments": { "market": "{{series}}.current" },
    "signals": {
      "book": "{{series}}.current.price.v1",
      "ofi": "btc.external.order_flow_imbalance.v1",
      "depth": "btc.external.actionable_depth_imbalance.v1"
    },
    "state": [],
    "triggers": [
      { "name": "bids_building_rich",
        "condition": { "all": [
          { "expr": "signal.ofi.ofi_base_10s", "comparator": ">=", "value": "{{min_flow_base}}" },
          { "expr": "signal.depth.combined_imbalance", "comparator": ">=", "value": "{{min_depth_imbalance}}" },
          { "signal": "book", "field": "ask", "comparator": ">=", "value": "{{rich}}" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "asks_building_rich",
        "condition": { "all": [
          { "expr": "0 - signal.ofi.ofi_base_10s", "comparator": ">=", "value": "{{min_flow_base}}" },
          { "expr": "0 - signal.depth.combined_imbalance", "comparator": ">=", "value": "{{min_depth_imbalance}}" },
          { "expr": "1 - signal.book.bid", "comparator": ">=", "value": "{{rich}}" }
        ] },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "1s" } },
      { "name": "tick",
        "condition": { "signal": "book" },
        "fire": "if_true", "rearm": { "mode": "immediate", "cooldown": "{{check}}" } }
    ],
    "legs": [
      { "name": "hunting", "resident": true, "arm": ["bids_building_rich", "asks_building_rich"],
        "body": [
          { "name": "fade_down",
            "if": "triggered(bids_building_rich) and platform.window.remaining_ms > {{cutoff}} and 1 - signal.book.bid < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "down", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp((1 - signal.book.bid) + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / (1 - signal.book.bid), 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "fade_down",
                  "on": { "fill": "holding_down", "partial": "holding_down", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding_down" },
          { "name": "fade_up",
            "if": "triggered(asks_building_rich) and platform.window.remaining_ms > {{cutoff}} and signal.book.ask < 0.9",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "up", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp(signal.book.ask + 0.02, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(envelope.allocation * {{stake}} / signal.book.ask, 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "fade_up",
                  "on": { "fill": "holding_up", "partial": "holding_up", "reject": "hunting", "cancel_ack": "hunting", "expiry": "hunting" }
              } }
            ],
            "then": "holding_up" }
        ] },
      { "name": "holding_down", "resident": true, "arm": ["tick"],
        "body": [
          { "name": "take_profit",
            "if": "triggered(tick) and platform.position.size <= -1 and 1 - signal.book.ask >= legs.hunting.tag.fade_down.fill_price + {{gain}}",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "up", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp(signal.book.ask + 0.01, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(abs(platform.position.size), 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "exit",
                  "on": { "fill": "done", "partial": "holding_down", "reject": "holding_down", "cancel_ack": "holding_down", "expiry": "holding_down" }
              } }
            ],
            "then": "done" }
        ] },
      { "name": "holding_up", "resident": true, "arm": ["tick"],
        "body": [
          { "name": "take_profit",
            "if": "triggered(tick) and platform.position.size >= 1 and signal.book.bid >= legs.hunting.tag.fade_up.fill_price + {{gain}}",
            "do": [
              { "place": {
                  "instrument": "market", "outcome": "down", "side": "buy",
                  "order_type": "limit", "tif": "ioc",
                  "price": "clamp((1 - signal.book.bid) + 0.01, 0.01, 0.99)",
                  "price_band": ["0.01", "0.99"],
                  "size": "clamp(platform.position.size, 0, envelope.max_order_size)",
                  "max_size": "envelope.max_order_size",
                  "tag": "exit",
                  "on": { "fill": "done", "partial": "holding_up", "reject": "holding_up", "cancel_ack": "holding_up", "expiry": "holding_up" }
              } }
            ],
            "then": "done" }
        ] },
      { "name": "done", "resident": true, "arm": [], "body": [] }
    ]
  }
}
