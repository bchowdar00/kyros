{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "jsx-a11y",
    "nextjs",
    "node"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "reference",
    "node_modules",
    ".next",
    "dist",
    "out",
    "coverage",
    "storybook-static",
    "playwright-report",
    "test-results",
    "*.d.ts",
    "pnpm-lock.yaml",
    ".agents/skills",
    ".mastra",
    ".mastra-data"
  ],
  "rules": {
    "array-callback-return": "warn",
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "no-console": "error",
    "no-empty": "error",
    "no-extra-boolean-cast": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "radix-ui",
            "message": "Import from a per-primitive entrypoint such as radix-ui/tabs."
          },
          {
            "name": "zod",
            "message": "Import from zod/mini. The full build is several times larger and reaches the client through env.ts and @kyros/domain."
          },
          {
            "name": "lodash",
            "message": "Use es-toolkit (one utility library, tree-shakeable)."
          },
          {
            "name": "lodash-es",
            "message": "Use es-toolkit (one utility library, tree-shakeable)."
          },
          {
            "name": "axios",
            "message": "Use @kyros/api, which wraps fetch with parsing, retries and typed results."
          },
          {
            "name": "moment",
            "message": "Use Intl.DateTimeFormat / Intl.RelativeTimeFormat through the app formatters."
          },
          {
            "name": "react-icons",
            "message": "Icons are generated into @kyros/ui/icons from supplied SVG assets."
          }
        ],
        "patterns": [
          {
            "group": ["lodash/*", "lodash-es/*"],
            "message": "Use es-toolkit (one utility library, tree-shakeable)."
          }
        ]
      }
    ],
    "no-regex-spaces": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_default"]
      }
    ],
    "no-useless-catch": "error",
    "node/no-process-env": "error",
    "prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "prefer-template": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react/button-has-type": "warn",
    "react/iframe-missing-sandbox": "warn",
    "react/no-danger": "warn",
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/require-module-specifiers": "off"
  },
  "overrides": [
    {
      "files": ["src/env.ts", "**/*.config.ts", "**/*.config.mjs", "**/scripts/**", "**/e2e/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/scripts/**", "**/e2e/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
