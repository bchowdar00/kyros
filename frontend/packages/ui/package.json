{
  "name": "@kyros/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./charts/*": "./src/charts/*.tsx",
    "./charts/lib/*": "./src/charts/lib/*.ts",
    "./icons/*": "./src/icons/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@svgr/core": "catalog:",
    "@svgr/plugin-jsx": "catalog:",
    "@svgr/plugin-svgo": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@kyros/testing": "workspace:*",
    "@kyros/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@number-flow/react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:"
  }
}
