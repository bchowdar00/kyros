# Every variable is validated in src/env.ts. Public ones are inlined at build time.
# Copy to .env.local for development; never commit a real .env file.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rust exchange (../server, `cargo run`, :8080).
# Server loaders read EXCHANGE_API_URL; the browser reads NEXT_PUBLIC_API_URL for REST orders
# and the /ws/* streams. Leave both unset to render the static fixtures instead.
EXCHANGE_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Serve the Teeny chat routes outside development (anonymous cookie identity; demo only).
# CHAT_ENABLED=1
# Hide series by underlying, e.g. `nba` for the BTC-only deployment. Server-side only.
# HIDDEN_UNDERLYINGS=

# Beacon endpoints. Unset means "do not report".
# NEXT_PUBLIC_VITALS_URL=
# NEXT_PUBLIC_ERROR_REPORT_URL=

# Teeny / Mastra (server-only). Absolute storage path lets Next.js and Studio share data.
OPENAI_API_KEY=
MASTRA_STORAGE_DIR=

# Superseded by the Rust exchange in this repo; kept for the Teeny price tools only.
# NEXT_PUBLIC_PRICE_FEEDS_URL=http://localhost:8083
# PRICE_FEEDS_API_URL=http://localhost:8083
# SILKROAD_API_URL=
# EXCHANGE_DEMO_UI_URL=
# EXCHANGE_DEMO_GATEWAY_URL=
# EXCHANGE_DEMO_FEED_URL=
