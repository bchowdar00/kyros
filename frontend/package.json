{
  "name": "@kyros/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze",
    "studio": "mastra dev",
    "lint": "oxlint",
    "lint:ci": "oxlint . --deny-warnings --format=github",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icons:generate": "pnpm --filter @kyros/ui icons:generate && biome format --write packages/ui/src/icons",
    "icons:check": "pnpm icons:generate && git diff --exit-code -- packages/ui/src/icons",
    "typecheck": "next typegen && tsc --noEmit && pnpm --filter \"./packages/**\" typecheck",
    "test": "vitest run && pnpm --filter \"./packages/**\" test",
    "test:watch": "vitest",
    "knip": "knip",
    "e2e": "next build && playwright test",
    "e2e:exchange": "playwright test --config playwright.exchange.config.ts",
    "check": "pnpm format:check && pnpm lint:ci && pnpm typecheck && pnpm test && pnpm knip && pnpm icons:check"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "@mastra/ai-sdk": "catalog:",
    "@mastra/core": "catalog:",
    "@mastra/libsql": "catalog:",
    "@mastra/memory": "catalog:",
    "@mastra/observability": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@kyros/api": "workspace:*",
    "@kyros/domain": "workspace:*",
    "@kyros/money": "workspace:*",
    "@kyros/ui": "workspace:*",
    "ai": "catalog:",
    "es-toolkit": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "three": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@kyros/postcss-config": "workspace:*",
    "@kyros/testing": "workspace:*",
    "@kyros/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "mastra": "catalog:",
    "msw": "catalog:",
    "oxlint": "catalog:",
    "react-grab": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:mastra",
    "vitest": "catalog:"
  }
}
